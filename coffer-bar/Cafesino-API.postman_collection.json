            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var token = pm.response.json().token;",
                  "    pm.environment.set('barista_token', token);",
                  "    pm.environment.set('barista_id', 'U001');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
